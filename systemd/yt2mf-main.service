[Unit]
Description=yt2mf Telegram Main Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yt2mf
Group=yt2mf
WorkingDirectory=/opt/yt2mf
EnvironmentFile=/etc/yt2mf/yt2mf.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/yt2mf/venv/bin/python -m app.main
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/yt2mf

[Install]
WantedBy=multi-user.target
